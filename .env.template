# Insanity Cluster Configuration Template
# Copy this file to .env and fill in your values

# ============================================================================
# SYSTEM CONFIGURATION
# ============================================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=insanity_cluster
POSTGRES_USER=insanity
POSTGRES_PASSWORD=insanity_dev_password
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ============================================================================
# QDRANT VECTOR DATABASE
# ============================================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=

# ============================================================================
# API CONFIGURATION
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================================================
# AI MODEL PROVIDERS
# ============================================================================

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_ORG_ID=
OPENAI_DEFAULT_MODEL=gpt-5-mini

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4.5

# OpenRouter Configuration
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local Model Configuration
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234

# ============================================================================
# MODEL ROUTING CONFIGURATION
# ============================================================================
OPERATING_MODE=mixed  # local, openrouter_free, mixed, web, openrouter_paid
DEFAULT_ROUTING_STRATEGY=cost_optimized  # speed_first, quality_first, cost_optimized, task_specific
MAX_COST_PER_TASK=1.0
MAX_COST_PER_DAY=50.0
LOCAL_COMPLEXITY_THRESHOLD=0.5

# ============================================================================
# COMMUNICATION INTEGRATIONS
# ============================================================================

# Twilio Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SendGrid Configuration
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Google Calendar Configuration
GOOGLE_CALENDAR_CREDENTIALS_PATH=
GOOGLE_CALENDAR_TOKEN_PATH=

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# OpenTelemetry Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=insanity-cluster

# ============================================================================
# SECURITY & COMPLIANCE
# ============================================================================
ENABLE_TLS=false
TLS_CERT_PATH=
TLS_KEY_PATH=

# Secrets Management
VAULT_ADDR=
VAULT_TOKEN=

# Data Retention
CONTEXT_RETENTION_DAYS=30
METRICS_RETENTION_DAYS=90
LOG_RETENTION_DAYS=30

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================
MAX_CONCURRENT_TASKS=100
TASK_TIMEOUT_SECONDS=300
MODEL_TIMEOUT_SECONDS=60
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_FACTOR=2

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=1000

# Cache Configuration
CACHE_TTL_SECONDS=3600
COMMAND_CACHE_TTL_DAYS=7

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================
ENABLE_CORS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
ENABLE_API_DOCS=true
ENABLE_METRICS_ENDPOINT=true
